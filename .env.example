# THE VOID — environment template (copy to .env — never commit .env)

# Optional overrides
# VOID_CC_HOST=127.0.0.1
# VOID_CC_PORT=7070

# Optional XDG/runtime overrides. Defaults stay under the current user's
# ~/.config, ~/.local/state, ~/.local/share, and ~/.cache roots.
# VOID_CONFIG_DIR=
# VOID_STATE_DIR=
# VOID_DATA_DIR=
# VOID_CACHE_DIR=
# VOID_RUNTIME_DIR=
# VOID_CC_SESSION_DB=
# VOID_CC_EXPORT_DIR=
# VOID_CC_DEMO_DIR=

# Commercial packages set these paths in their fixed launch wrappers. Source
# checkouts leave enforcement disabled unless explicitly testing licensing.
# VOID_REQUIRE_LICENSE=0
# VOID_LICENSE_FILE=
# VOID_LICENSE_PUBLIC_KEY=

# Release operators: never store a value here or in any tracked file.
# VOID_LICENSE_KEY_PASSPHRASE=

# Cloud credentials: use your secret manager / env — NEVER put keys in the repo
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_CLIENT_ID=
